{
  "name": "qwen-standalone-dp2-pp2-bf16",
  "model": {"kind": "moss", "path": "$MODEL_ROOT/MOSS-Image-Base"},
  "preparation": {
    "backend": "vllm", "auto_prepare": false, "async_prefetch": false,
    "vllm": {
      "python": "$CONDA_PREFIX/envs/vllm_env/bin/python",
      "devices": [0, 1, 2, 3], "tensor_parallel_size": 1,
      "pipeline_parallel_size": 2, "data_parallel_size": 2,
      "topology_aware": true, "storage_dtype": "bfloat16",
      "batch_size": 32, "max_num_seqs": 8, "max_num_batched_tokens": 8192,
      "gpu_memory_utilization": 0.8, "enforce_eager": false
    }
  },
  "data": {
    "prompts": "$DATA_DISK/phone-uploads/NovelAI/prompts_negative_nsfw_moss_deepseek_20261023.jsonl",
    "cache": "$MOSS_ROOT/cache/qwen_dp2_pp2_bf16_20261024",
    "context_length": 512, "short_context_length": 288
  }
}
