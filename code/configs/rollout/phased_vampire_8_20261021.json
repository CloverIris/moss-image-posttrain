{
  "model": {
    "base_precision": "mxfp8",
    "attention_backend": "cudnn",
    "dit_autotune_level": 4,
    "path": "$MODEL_ROOT/MOSS-Image-SFT",
    "vae_conv_backend": "cudnn_bounded",
    "vae_conv_workspace_mib": 256
  },
  "data": {
    "prompts": "$CODE_ROOT/moss-art-jax/data/vampire_elf_prompt_pair_20261021_prompt1.jsonl",
    "cache": "cache/vampire_elf_prompt_pair_20261021_prompt1",
    "short_context_length": 512,
    "context_length": 1024,
    "negative_prompt": ""
  },
  "rollout": {
    "count": 8,
    "seed": 42,
    "prompts_per_batch": 1,
    "decode": true,
    "save_latents": true,
    "cache_intermediates": true
