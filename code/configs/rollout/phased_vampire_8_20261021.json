  "sampling": {
    "height": 768,
    "width": 1792,
    "steps": 50,
    "sampler": "euler",
    "scheduler": "moss",
    "guidance_scale": 3.0,
    "shift": 5.0,
    "training_shift": 1.0
  },
  "preparation": {
    "device": 4,
    "async_prefetch": true
  },
  "runtime": {
    "devices": [
      0,
      1,
      2,
      3
    ],
    "output_dir": "outputs/phased_vampire_8_20261021_retry"
  }
