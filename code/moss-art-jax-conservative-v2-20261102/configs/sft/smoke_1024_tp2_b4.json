{
  "model": {
    "attention_backend": "cudnn",
    "dit_autotune_level": 4,
    "activation_storage": "gpu",
    "checkpoint_interval": 1
  },
  "data": {
    "cache": "cache/sft_1024_smoke",
    "context_length": 4096,
    "short_context_length": 0
  },
  "lora": {
    "rank": 4,
    "alpha": 4.0,
    "preset": "attn-mlp"
  },
  "sft": {
    "conditioning_dropout": 0.0
  },
  "training": {
    "max_updates": 3,
    "batch_size": 4,
    "checkpoint_every": 3,
    "seed": 42
  },
  "runtime": {
    "devices": [
      0,
      3,
      1,
      2
    ],
    "tensor_parallel_size": 2,
    "output_dir": "outputs/sft_1024_tp2_b4"
  }
}
