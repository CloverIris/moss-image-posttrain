{
  "name": "base-pixai-threshold-coverage-hanfu-48step",
  "model": {
    "path": "$MODEL_ROOT/MOSS-Image-Base",
    "attention_backend": "cudnn",
    "dit_autotune_level": 4,
    "activation_storage": "gpu",
    "checkpoint_interval": 6,
    "vae_conv_backend": "cudnn_bounded",
    "vae_conv_workspace_mib": 256
  },
  "preparation": {
    "device": 4,
    "async_prefetch": true
  },
  "data": {
    "prompts": "$CODE_ROOT/moss-art-jax/data/pixai_threshold_rl_20261021.jsonl",
    "cache": "cache/pixai_threshold_rl_20261021",
    "short_context_length": 256,
    "context_length": 512
  },
  "lora": {
    "rank": 48,
    "alpha": 48.0,
    "preset": "attn"
  },
  "sampling": {
    "height": 1024,
    "width": 1024,
    "steps": 48,
    "sampler": "euler",
    "scheduler": "moss",
    "group_size": 4,
    "prompts_per_rollout": 1,
    "split_group_across_workers": true,
    "train_timesteps": [
      0,
      10,
      20,
      30,
      40
    ],
    "guidance_scale": 3.0
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.0001
  },
  "training": {
    "max_updates": 6,
    "evaluate_every": 2,
    "checkpoint_every": 2,
    "keep_checkpoints": 2
  },
  "reward": {
    "kind": "pixai",
    "model_path": "$MODEL_ROOT/pixai-tagger-v1.0/model.safetensors",
    "metric": "coverage",
    "dtype": "bfloat16",
    "attention_backend": "cudnn",
    "metadata_dir": "$CODE_ROOT/moss-art-jax/vendor/pixai_tagger/metadata",
    "batch_size": 1
  },
  "logging": {
    "tensorboard": true
  },
  "runtime": {
    "devices": [
      0,
      1,
      2,
      3
    ],
    "output_dir": "outputs/pixai_threshold_rl_48step"
  }
}
