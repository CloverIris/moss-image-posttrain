{
  "name": "moss-train-1024-fast-vae",
  "model": {
    "attention_backend": "cudnn",
    "dit_autotune_level": 4,
    "vae_conv_backend": "cudnn_bounded",
    "vae_conv_workspace_mib": 256,
    "vae_precision": "fp32"
  },
  "data": {
    "prompts": "configs/prompts_1024_probe.jsonl",
    "short_context_length": 0,
    "context_length": 4096
  },
  "lora": {
    "rank": 4,
    "alpha": 4.0,
    "preset": "attn"
  },
  "sampling": {
    "sampler": "euler",
    "scheduler": "moss",
    "height": 1024,
    "width": 1024,
    "steps": 10,
    "prompts_per_rollout": 1,
    "group_size": 2,
    "train_timesteps": [
      0,
      2,
      4,
      6,
      8
    ]
  },
  "training": {
    "max_updates": 2,
    "checkpoint_every": 2,
    "evaluate_every": 0
  },
  "reward": {
    "kind": "siglip",
    "decode": true,
    "batch_size": 1
  },
  "runtime": {
    "devices": [
      3
    ],
    "output_dir": "outputs/train_1024_fast_vae"
  },
  "preparation": {
    "device": 4,
    "auto_prepare": true,
    "async_prefetch": true
  }
}
