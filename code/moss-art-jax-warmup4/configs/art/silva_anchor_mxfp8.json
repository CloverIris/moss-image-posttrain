    "profiles": [
      {
        "height": 768,
        "width": 768,
        "weight": 2,
        "rollout_batch_size": 1,
        "microbatch_size": 1
      },
      {
        "height": 1024,
        "width": 1024,
        "weight": 1,
        "rollout_batch_size": 1,
        "microbatch_size": 1
      }
    ]
  },
  "run": {
    "resume": "",
    "init_adapter": "",
    "checkpoint": "",
    "adapter": ""
  }
