{
  "name": "silva_anchor_mxfp8",
  "model": {
    "path": "$MODEL_ROOT/MOSS-Image-Base",
    "attention_backend": "cudnn",
    "dit_autotune_level": 4,
    "activation_storage": "gpu",
    "checkpoint_interval": 6,
    "vae_conv_backend": "cudnn_bounded",
    "vae_conv_workspace_mib": 256
  },
  "preparation": {
    "device": 4,
    "async_prefetch": true,
    "qwen_gpu_layers": 16,
    "qwen_gpu_embedding": true,
    "qwen_gpu_vision": true,
    "max_sequence_length": 512
  },
  "data": {
    "prompts": "$DATA_DISK/phone-uploads/NovelAI/prompts_negative_nsfw_moss_deepseek_20261023.jsonl",
    "cache": "$CODE_ROOT/moss-art-jax/cache/silva",
    "short_context_length": 288,
    "context_length": 512
  },
  "lora": {
    "rank": 48,
    "alpha": 48.0,
    "preset": "attn"
  },
  "sampling": {
    "height": 768,
    "width": 768,
    "steps": 48,
    "sampler": "euler",
    "scheduler": "moss",
    "guidance_scale": 3.0,
    "pair_cached_points": true,
    "rollout_batch_size": 1,
    "rollout_mode": "mxfp8",
    "vae_resident_rollout": true
  },
  "optimizer": {
    "name": "adamw",
