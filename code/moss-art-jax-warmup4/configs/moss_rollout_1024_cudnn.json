{
  "name": "moss-rollout-1024-cudnn",
  "model": {
    "attention_backend": "cudnn",
    "dit_autotune_level": 0
  },
  "lora": {
    "rank": 4,
    "alpha": 4.0,
    "preset": "attn"
  },
  "sampling": {
    "sampler": "euler",
    "scheduler": "moss",
    "height": 1024,
    "width": 1024,
    "steps": 10,
    "prompts_per_rollout": 2,
    "group_size": 2,
    "train_timesteps": [
      0,
      2,
      4,
      6,
      8
    ]
  },
  "training": {
    "max_updates": 2,
    "checkpoint_every": 2,
    "evaluate_every": 0
  },
  "reward": {
    "kind": "siglip",
    "decode": true,
    "batch_size": 1
  },
  "runtime": {
    "devices": [
      1
    ],
    "output_dir": "outputs/rollout_1024_cudnn"
  }
}
