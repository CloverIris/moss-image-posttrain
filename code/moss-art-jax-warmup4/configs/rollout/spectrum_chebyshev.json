{
  "data": {
    "prompts": "configs/rollout/prompts_tags.txt",
    "cache": "cache/rollout_only",
    "short_context_length": 512,
    "context_length": 4096
  },
  "model": {
    "path": "$MODEL_ROOT/MOSS-Image-Base",
    "base_precision": "mxfp8",
    "activation_storage": "gpu",
    "vae_precision": "float16",
    "vae_low_precision_stages": ["input", "mid", "up0", "up1", "up2", "up3", "output"],
    "vae_conv_backend": "tiled_gemm"
  },
  "rollout": {
    "count": 8,
    "seed": 42,
    "prompts_per_batch": 4,
    "decode": true,
    "save_latents": false,
    "cache_intermediates": false
  },
  "sampling": {
    "height": 1024,
    "width": 1024,
    "steps": 48,
    "sampler": "res_multistep",
    "scheduler": "beta",
    "guidance_scale": 3.0,
    "vae_resident_rollout": true,
    "spectrum": {
      "enabled": true,
      "degree": 3,
      "ridge_lambda": 0.1,
      "blend_weight": 0.3,
      "window_size": 2.0,
      "flex_window": 0.5,
      "warmup_steps": 6,
      "tail_actual_steps": 3,
      "history_size": 100
    }
  },
  "preparation": {"device": 4, "async_prefetch": true},
  "runtime": {
    "devices": [0, 1, 2, 3],
    "output_dir": "$MOSS_ROOT/rollouts/spectrum_chebyshev"
  }
}
