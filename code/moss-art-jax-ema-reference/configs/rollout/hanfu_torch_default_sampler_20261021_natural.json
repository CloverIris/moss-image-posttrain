{
  "model": {
    "base_precision": "mxfp8",
    "attention_backend": "cudnn",
    "dit_autotune_level": 4,
    "path": "$MODEL_ROOT/MOSS-Image-SFT"
  },
  "data": {
    "prompts": "$CODE_ROOT/moss-art-jax/data/hanfu_tags_vs_natural_20261021_natural.jsonl",
    "cache": "cache/hanfu_tags_vs_natural_20261021_natural",
    "short_context_length": 512,
    "context_length": 1024,
    "negative_prompt": ""
  },
  "rollout": {
    "count": 4,
    "seed": 42,
    "prompts_per_batch": 1,
    "decode": true,
    "save_latents": false
  },
  "sampling": {
    "height": 1216,
    "width": 832,
    "steps": 50,
    "sampler": "euler",
    "scheduler": "moss",
    "guidance_scale": 3.0,
    "shift": 5.0,
    "training_shift": 1.0
  },
  "preparation": {
    "device": 4,
    "async_prefetch": true
  },
  "runtime": {
    "devices": [
      0,
      1,
      2,
      3
    ],
    "output_dir": "outputs/hanfu_torch_default_sampler_20261021_natural"
  }
}
