{
  "name": "ema-reference-tiny-cpu",
  "model": {
    "kind": "tiny",
    "dtype": "float32",
    "activation_storage": "gpu",
    "checkpoint_interval": 2
  },
  "lora": {
    "rank": 2,
    "alpha": 2.0,
    "preset": "attn"
  },
  "data": {
    "prompts": "configs/prompts.jsonl",
    "context_length": 16,
    "short_context_length": 8
  },
  "sampling": {
    "rollout_mode": "bf16",
    "height": 32,
    "width": 32,
    "steps": 4,
    "group_size": 4,
    "rollout_batch_size": 1,
    "prompts_per_rollout": 1,
    "split_group_across_workers": true,
    "pair_cached_points": false,
    "guidance_scale": 1.5,
    "skip_layers": [
      1
    ],
    "sampler": "euler",
    "scheduler": "moss",
    "train_timesteps": [
      0,
      3
    ]
  },
  "art": {
    "reference_mode": "ema",
    "reference_ema_decay": 0.99,
    "reference_mse_beta": 1.0
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.0001,
    "warmup_steps": 4
  },
  "training": {
    "prompts_per_update": 2,
    "rollouts_per_prompt": 4,
    "training_points_per_trajectory": 2,
    "microbatch_size": 1,
    "max_updates": 4,
    "updates_per_rollout": 2,
    "checkpoint_every": 2,
    "keep_checkpoints": 3,
    "evaluate_every": 0
  },
  "logging": {
    "tensorboard": true
  },
  "reward": {
    "kind": "toy_latent",
    "decode": false
  },
  "runtime": {
    "execution_backend": "mesh",
    "devices": [
      0,
      1
    ],
    "platform": "cpu",
    "cpu_threads": 2,
    "output_dir": "outputs/ema_reference_tiny_cpu_example"
  }
}
